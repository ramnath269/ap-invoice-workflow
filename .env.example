# Copy to .env and fill in. JDE_USERNAME / JDE_PASSWORD were hardcoded in the
# original n8n workflow (Code in JavaScript2 node) - move them out of source
# control here instead.
JDE_USERNAME=ORCHSVC
JDE_PASSWORD=change-me

# Folder watched for new invoices (replaces n8n Local File Trigger1)
WATCH_FOLDER=/home/node/.n8n-files
PROCESSED_SUBFOLDER=processed_files

# Google Cloud - Document AI (OCR) + Vertex AI (Gemini extraction)
# Auth uses Application Default Credentials:
#   gcloud auth application-default login
# or set GOOGLE_APPLICATION_CREDENTIALS to a service account key file.
GCP_PROJECT_ID=678280534943
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=da343bda4810bc17
VERTEX_PROJECT_ID=invoice-ai-platform-496910
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated PII entity types to redact before sending text to Gemini
PII_ENTITIES=CREDIT_CARD,EMAIL_ADDRESS

# JD Edwards orchestrator (PO receipt inquiry / voucher match)
JDE_ORCHESTRATOR_URL=http://71.42.117.252:8130/jderest/orchestrator/55_ORCH_PO_ReceiptFile_Inquiry_V2

# Invoice server (final PO creation + workflow metrics)
INVOICE_SERVER_BASE_URL=https://aoctest.webine3.com/invoice-server
